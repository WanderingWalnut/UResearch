NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Neon waitlist. Pooled URL for the app. Keep this server-side (never NEXT_PUBLIC_).
DATABASE_URL=postgresql://role:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require
# Direct URL for SQL migrations only.
DATABASE_URL_UNPOOLED=postgresql://role:password@your-endpoint.neon.tech/neondb?sslmode=require

# Set true on Vercel Production only; keep false locally and on Preview.
WAITLIST_ONLY=false
